{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HomeFlow Trip v1",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "importSourceId",
    "trip"
  ],
  "properties": {
    "format": {
      "const": "homeflow.trip"
    },
    "schemaVersion": {
      "const": 1
    },
    "importSourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "trip": {
      "type": "object",
      "required": [
        "externalId",
        "title",
        "destination",
        "startDate",
        "endDate",
        "timeZone",
        "participants",
        "currency",
        "budget",
        "days"
      ],
      "properties": {
        "externalId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "timeZone": {
          "type": "string"
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "budget": {
          "type": "object",
          "required": [
            "amount",
            "currency",
            "status"
          ]
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "date",
              "items"
            ]
          }
        },
        "tasks": {
          "type": "array"
        },
        "packingLists": {
          "type": "array"
        },
        "bookings": {
          "type": "array"
        },
        "reminders": {
          "type": "array"
        }
      }
    }
  }
}
